# Application
APP_ENV=development
APP_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=Ertip Report App
SESSION_SECRET=replace-with-at-least-32-random-characters

# Odoo Online — API key must remain a runtime secret.

# Application
APP_ENV=development
APP_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=Ertip Report App

# PostgreSQL
DATABASE_URL=postgresql://ertip:ertip@127.0.0.1:5432/ertip_report
DATABASE_SSL=false

# Authentication — generate independent random values.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
OWNER_BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters

# Odoo Online — API key must remain a runtime secret.
ODOO_BASE_URL=https://ertipmedical.odoo.com
ODOO_DATABASE=ertipmedical
ODOO_API_KEY=
ODOO_REQUEST_TIMEOUT_MS=15000

# Runtime
PORT=3000
HOSTNAME=0.0.0.0

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/web/*"
      ],
      "@ertip/auth": [
        "packages/auth/src/index.ts"
      ],
      "@ertip/config": [
        "packages/config/src/index.ts"
      ],
      "@ertip/db": [
        "packages/db/src/index.ts"
      ],
      "@ertip/odoo-client": [
        "packages/odoo-client/src/index.ts"
      ],
      "@ertip/reporting": [
        "packages/reporting/src/index.ts"
      ],
      "@ertip/sync": [
        "packages/sync/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "playwright-report",
    "test-results"
  ]
}
